# /etc/smstools-http-api/settings.py - read via SMSTOOLS_HTTP_API_SETTINGS
# Overrides config.py without editing it.

# Accept and log messages, but do not hand them to smsd (no modem/SIM yet).
DEMO = False

# HTTP basic auth users (htpasswd, e.g. "htpasswd -B /etc/smstools-http-api/htpasswd.users ma1sd")
HTPASSWD_PATH = "/etc/smstools-http-api/htpasswd.users"

# Accounts that may read and delete all messages
#ADMIN_ACCOUNTS = ['admin']

# Default smsd queue
#DEFAULTQUEUE = "GSM1"

# Per-user number whitelist
#USER_WHITELIST = {'ma1sd': ['436761234567']}

# Webhooks for smsd events. Needs in /etc/smsd.conf (global section):
#   eventhandler = /usr/bin/smstools-http-api-event
# and the worker: systemctl enable --now smstools-http-api-webhooks
# Events: RECEIVED, SENT, FAILED, REPORT, CALL. The default body is the event:
#   {"event": "RECEIVED", "message_id": "GSM1.xyz", "kind": "incoming",
#    "from": "436761234567", "to": null, "modem": "GSM1", "sms_id": null,
#    "text": "...", "headers": {"From": ..., "Sent": ..., ...}, "time": "2026-...+00:00"}
# Optional per hook: headers, auth=(user, password), timeout, verify=False,
# filter(event) -> bool, payload(event) -> body, check(status, body) -> bool.
#WEBHOOKS = [
#    {'name': 'example', 'url': 'https://hooks.example.org/sms',
#     'events': ['RECEIVED'], 'headers': {'Authorization': 'Bearer TOKEN'}},
#
#    # Mail received SMS (type 'email': SMTP instead of HTTP; optional starttls,
#    # smtp_ssl, smtp_auth=(user, password), subject, body)
#    {'name': 'mail', 'type': 'email', 'events': ['RECEIVED'],
#     'to': 'me@example.org', 'from': 'sms@example.org',
#     'smtp_host': 'mail.example.org', 'smtp_port': 25},
#
#    # Zabbix >= 7.0: push received SMS into a trapper item (key sms.received,
#    # type text) of host "gotify" via the API (token of a user with write
#    # access to that host). history.push answers HTTP 200 also on errors,
#    # so "check" looks into the JSON-RPC response.
#    {'name': 'zabbix', 'url': 'https://zabbix.example.org/api_jsonrpc.php',
#     'events': ['RECEIVED'],
#     'headers': {'Authorization': 'Bearer ZABBIX_API_TOKEN'},
#     'payload': lambda e: {'jsonrpc': '2.0', 'method': 'history.push', 'id': 1,
#                           'params': [{'host': 'gotify', 'key': 'sms.received',
#                                       'value': '%s: %s' % (e['from'], e['text'])}]},
#     'check': lambda status, body: status == 200 and 'error' not in body},
#]

# Address book for 'route' hooks and mail2sms: a CardDAV address book ('?export'
# returns all vCards; cached, fetched again after ttl seconds) or a vCard file.
#CONTACTS = {'url': 'https://cloud.example.org/remote.php/dav/addressbooks/users/smsgw/family/?export',
#            'auth': ('smsgw', 'APP-PASSWORD'), 'ttl': 900}
#CONTACTS = {'file': '/etc/smstools-http-api/contacts.vcf'}
#COUNTRY_CODE = '43'          # for numbers written as 0676...

# Route received SMS by leading @tokens ("@mum @dad dinner at 6") to the contacts'
# mail addresses; no (known) token -> default_to. Tokens in 'skip' are handled by
# other hooks, e.g. Zabbix with
#   'filter': lambda e: 'zabbix' in parse_tokens(e['text'])[0]
# (from smstools_http_api.webhooks import parse_tokens).
#WEBHOOKS += [
#    {'name': 'route', 'type': 'route', 'events': ['RECEIVED'],
#     'domain': 'sms.example.org', 'default_to': 'me@example.org',
#     'skip': ['zabbix'], 'mail_domains': ['example.org'],
#     'smtp_host': 'mail.example.org', 'smtp_port': 25,
#     'texts': {'subject': 'SMS von {name}', 'footer': 'Antworten auf diese Mail geht als SMS an {name}.',
#               'unknown': 'Unbekannte Empfaenger: {names}'}},
#]

# mail2sms (smstools-http-api-mail2sms, Postfix pipe): who may send. Senders with an
# address of a contact (in these domains, if set) plus MAIL2SMS_SENDERS.
#MAIL2SMS_SENDER_DOMAINS = ['example.org']
#MAIL2SMS_SENDERS = []
# Hosts/networks whose mail is trusted (own mail server, authenticated submission);
# mail from other clients needs a topmost 'Received-SPF: pass' (added by the own
# gateway). Postfix passes the client: argv=... --client ${client_address} ${sender} ${recipient}
#MAIL2SMS_TRUSTED_CLIENTS = ['192.0.2.10']
#MAIL2SMS_PREFIX = True       # "Mario: text"
#MAIL2SMS_MAX_PARTS = 3

# Give up on an event after this many seconds (moved to WEBHOOK_QUEUE/failed)
#WEBHOOK_MAX_AGE = 86400

# Eventhandler that was set in smsd.conf before; it is run first with the same arguments
#EVENTHANDLER_CHAIN = '/usr/local/bin/my-smsd-handler'
