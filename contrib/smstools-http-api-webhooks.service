[Unit]
Description=Webhooks for SMS Server Tools 3 events (smstools-http-api)
After=network-online.target
Wants=network-online.target

[Service]
User=smsd
Group=smsd
UMask=0007
WorkingDirectory=/opt/smstools-http-api
Environment=FLASK_CONFIG=production
Environment=SMSTOOLS_HTTP_API_SETTINGS=/etc/smstools-http-api/settings.py
ExecStart=/usr/bin/python3 -m smstools_http_api.hooks_cli worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/sms
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
